[
 {
  "id": "title_00",
  "seg": "title",
  "t": 0.0,
  "hold": "end",
  "tone": "drama",
  "text": "左の脳と、右の脳は、同じ答えを出すのか？"
 },
 {
  "id": "title_01",
  "seg": "title",
  "t": 1.5,
  "hold": "end",
  "tone": "normal",
  "text": "ハエの全配線図から作った、およそ十四万個のニューロンの脳シミュレーションで、きょうぞうテストをしてみました。"
 },
 {
  "id": "round1_00",
  "seg": "round1",
  "t": 0.0,
  "hold": "end",
  "tone": "hot",
  "text": "第一ラウンド。"
 },
 {
  "id": "round1_01",
  "seg": "round1",
  "t": 0.8,
  "hold": "end",
  "tone": "normal",
  "text": "砂糖のセンサーを刺激して、口吻を伸ばす神経、エムエヌナインが動くか。左右の脳で、まったく同じ実験をします。"
 },
 {
  "id": "battle1_00",
  "seg": "battle1",
  "t": 0.0,
  "hold": "end",
  "tone": "normal",
  "text": "左右どちらかの砂糖センサーに、同じ強さの刺激を入れます。"
 },
 {
  "id": "battle1_01",
  "seg": "battle1",
  "t": 1.3,
  "hold": "end",
  "tone": "normal",
  "text": "左の脳では、口吻を伸ばす神経が、すぐに動き出しました。"
 },
 {
  "id": "battle1_02",
  "seg": "battle1",
  "t": 3.4,
  "hold": "end",
  "tone": "hot",
  "text": "ところが、右の脳では、活動が脳全体へ広がって、止まらなくなりました。暴走です。"
 },
 {
  "id": "battle1_03",
  "seg": "battle1",
  "t": 13.0,
  "hold": "end",
  "tone": "drama",
  "text": "左は、砂糖を飲める。右は、脳全体が暴走して、飲めません。"
 },
 {
  "id": "cause1_00",
  "seg": "cause1",
  "t": 0.0,
  "hold": "end",
  "tone": "drama",
  "text": "なぜでしょうか。ひとつめの原因は、右の砂糖センサーの、シナプスの数です。"
 },
 {
  "id": "cause1_01",
  "seg": "cause1",
  "t": 1.5,
  "hold": "end",
  "tone": "normal",
  "text": "配線図の上では、右のセンサーのシナプスは、左の半分ほどしかありません。"
 },
 {
  "id": "cause1_02",
  "seg": "cause1",
  "t": 2.5,
  "hold": "end",
  "tone": "normal",
  "text": "左のセンサーから、同じだけシナプスを抜くと、左の脳でも、口吻は伸びなくなりました。右の失敗は、脳の違いではなく、配線図の取りこぼしで説明できそうです。"
 },
 {
  "id": "cause2_00",
  "seg": "cause2",
  "t": 0.0,
  "hold": "end",
  "tone": "drama",
  "text": "では、なぜ暴走まで起きたのか。右の砂糖センサーを、一個ずつ抜いて調べました。"
 },
 {
  "id": "cause2_01",
  "seg": "cause2",
  "t": 1.0,
  "hold": "end",
  "tone": "normal",
  "text": "すると、たった一個のセンサーが、嗅覚の中枢、しょっかくようへ、二十二個ものシナプスを出していました。左では、多くても三個です。これが、暴走の入口です。"
 },
 {
  "id": "cause2_02",
  "seg": "cause2",
  "t": 2.5,
  "hold": "end",
  "tone": "normal",
  "text": "そして、増幅器。しょっかくようの四十個の細胞を、エーアイが、セロトニンと判定していました。モデルではアクセル扱いですが、本来は、ブレーキ役のはずの細胞です。"
 },
 {
  "id": "cause2_03",
  "seg": "cause2",
  "t": 5.0,
  "hold": "end",
  "tone": "hot",
  "text": "入口と増幅器、どちらか一方を取り除くだけで、右の暴走は消えました。"
 },
 {
  "id": "battle2_00",
  "seg": "battle2",
  "t": 0.0,
  "hold": "end",
  "tone": "hot",
  "text": "第二ラウンド。"
 },
 {
  "id": "battle2_01",
  "seg": "battle2",
  "t": 0.6,
  "hold": "end",
  "tone": "normal",
  "text": "右の配線図の、ふたつの違いを補正します。足りないシナプスを、左と同じ量に補い、しょっかくようの四十個の符号を直しました。"
 },
 {
  "id": "battle2_02",
  "seg": "battle2",
  "t": 1.3,
  "hold": "end",
  "tone": "normal",
  "text": "すると、右の脳でも、口吻を伸ばす神経が、動き始めました。"
 },
 {
  "id": "battle2_03",
  "seg": "battle2",
  "t": 10.0,
  "hold": "end",
  "tone": "joy",
  "text": "補正すると、右の脳も、砂糖を飲めるようになりました。"
 },
 {
  "id": "tournament_00",
  "seg": "tournament",
  "t": 0.0,
  "hold": "end",
  "tone": "hot",
  "text": "最後は、誤りトーナメント。配線図に、わざと誤りを入れても、ハエは砂糖を飲めるのか。"
 },
 {
  "id": "tournament_01",
  "seg": "tournament",
  "t": 3.0,
  "hold": "end",
  "tone": "normal",
  "text": "偽のシナプスを、八十パーセント足しても、ほとんど変わりません。ところが、シナプスを二十パーセント見逃すだけで、効果は半分に。四十パーセントでは、ゼロになりました。"
 },
 {
  "id": "tournament_02",
  "seg": "tournament",
  "t": 4.0,
  "hold": "end",
  "tone": "normal",
  "text": "アクセルとブレーキの取り違えや、シナプスの強さのばらつきは、ときに、暴走の引き金にもなりました。"
 },
 {
  "id": "ending_00",
  "seg": "ending",
  "t": 0.0,
  "hold": "end",
  "tone": "normal",
  "text": "わかったこと。"
 },
 {
  "id": "ending_01",
  "seg": "ending",
  "t": 0.5,
  "hold": "end",
  "tone": "normal",
  "text": "同じ脳の左右で、シミュレーションの答えが、食い違いました。百三十一種類の感覚でも、同じです。"
 },
 {
  "id": "ending_02",
  "seg": "ending",
  "t": 1.5,
  "hold": "end",
  "tone": "normal",
  "text": "原因は、おそらく、脳ではなく配線図。シナプスの取りこぼし、一個の異常な配線、そして、伝達物質の、ごはんていです。ただし、補正は左を基準にしたもので、どちらの半球が正しいかは、まだわかりません。"
 },
 {
  "id": "ending_03",
  "seg": "ending",
  "t": 2.5,
  "hold": "end",
  "tone": "normal",
  "text": "シナプスを、十四から二十四パーセント見逃すだけで、多くの予測は、効果が半分になります。"
 },
 {
  "id": "ending_04",
  "seg": "ending",
  "t": 3.5,
  "hold": "end",
  "tone": "drama",
  "text": "配線図のシミュレーションは、左右で答え合わせをしてから、信じましょう。"
 }
]
